# Resend API key - get one at https://resend.com
RESEND_API_KEY=

# Address the enquiry form sends TO (your business inbox)
ENQUIRY_TO_EMAIL=

# Address Resend sends FROM (must be a verified sender/domain in Resend)
ENQUIRY_FROM_EMAIL=

# Staff-only code to unlock the /contract page. Give this to no one
# except your own staff, in person - do not text or email it.
CONTRACT_ACCESS_PIN=

# Random secret used to sign the short-lived contract session token.
# Any long random string works, e.g. generate one at https://randomkeygen.com
CONTRACT_TOKEN_SECRET=

# Optional - where signed contracts get emailed to on the business side.
# Leave blank to reuse ENQUIRY_TO_EMAIL.
CONTRACT_TO_EMAIL=
